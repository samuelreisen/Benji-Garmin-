# Copy to .env and fill in. NEVER commit .env.

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Garmin (unofficial garminconnect login). Leave blank once tokens are cached.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# App login. Generate with: python -m app.cli hash-password
APP_PASSWORD_HASH=
# Generate both with: python -m app.cli gen-secrets
SESSION_SECRET=
TOKEN_ENC_KEY=

# Where the database and encrypted Garmin tokens live. Point tests/experiments at a scratch folder.
BENJI_DATA_DIR=./data

# Set to 0 only for local http testing. Keep 1 in production (https).
COOKIE_SECURE=1

# Local hour (0-23) the daily briefing is generated, and its timezone.
BRIEFING_HOUR=7
TZ_NAME=Australia/Sydney
